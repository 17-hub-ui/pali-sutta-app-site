          "id": "s1-l1",
          "pali": "Pāṇātipātā veramaṇī sikkhā padaṃ samādiyāmi.",
          "kana": "バーナーティパーター ヴェーラマニー スィッカー パダン サマーディヤーミ",
          "ja": "「生き物を殺さない」という戒めを私は受けて守ります。",
          "wordGlosses": [
            {
              "pali": "Pāṇātipātā",
              "kana": "バーナーティパーター",
              "ja": "生き物を殺すこと"
            },
            {
              "pali": "veramaṇī",
              "kana": "ヴェーラマニー",
              "ja": "離れる"
            },
            {
              "pali": "sikkhā",
              "kana": "スィッカー",
              "ja": "学"
            },
            {
